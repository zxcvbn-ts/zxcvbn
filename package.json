{
  "workspaces": [
    "packages/languages/*",
    "packages/libraries/*"
  ],
  "private": true,
  "name": "zxcvbn-ts",
  "version": "4.4.2",
  "type": "module",
  "engines": {
    "node": ">=18.18.0"
  },
  "description": "Realistic password strength estimation written in typescript",
  "author": "zxcvbn-ts",
  "license": "MIT",
  "homepage": "https://github.com/zxcvbn-ts/zxcvbn",
  "repository": {
    "type": "git",
    "url": "git@github.com:zxcvbn-ts/zxcvbn.git"
  },
  "files": [],
  "prettier": "./prettier.mjs",
  "scripts": {
    "build": "lerna exec --parallel -- rollup -c ../../../scripts/rollup.config.mjs",
    "lint": "eslint --ext .js,.mjs,.ts . ",
    "lint:fix": "yarn run lint --fix --cache",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:silent": "vitest run --reporter=minimal --silent=passed-only --diff.contextLines=2",
    "test:coverage:silent": "yarn -s test:silent --coverage --coverage.reporter=text-summary",
    "test:types": "lerna exec --parallel -- attw --pack --profile esm-only .",
    "changed": "lerna changed",
    "release": "tsx ./scripts/release/release.ts",
    "benchmark": "tsx ./scripts/benchmark/index.ts",
    "benchmark:silent": "yarn -s tsx ./scripts/benchmark/index.ts --compact",
    "generate:languageData": "tsx ./data-scripts/generate.ts",
    "generate:deduplicate": "tsx ./data-scripts/deduplicate.ts",
    "wikipediaExtractor": "tsx ./data-scripts/wikiExtractor/index.ts ./data-scripts/extracts",
    "docs:dev": "vuepress dev docs",
    "docs:build": "vuepress build docs"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.3",
    "@eslint/compat": "2.0.5",
    "@eslint/js": "10.0.1",
    "@rollup/plugin-alias": "6.0.0",
    "@rollup/plugin-json": "6.1.0",
    "@rollup/plugin-node-resolve": "16.0.3",
    "@rollup/plugin-terser": "1.0.0",
    "@rollup/plugin-typescript": "12.3.0",
    "@sindresorhus/transliterate": "2.3.1",
    "@types/byline": "4.2.36",
    "@types/sprintf-js": "1.1.4",
    "@typescript-eslint/parser": "8.59.0",
    "@vitest/coverage-v8": "5.0.5",
    "@vitest/eslint-plugin": "1.6.27",
    "@vuepress/bundler-vite": "2.0.0-rc.28",
    "@vuepress/plugin-register-components": "2.0.0-rc.128",
    "@vuepress/theme-default": "2.0.0-rc.128",
    "@zxcvbn-ts/dictionary-compression": "3.0.1",
    "axios": "1.15.2",
    "byline": "5.0.0",
    "chinese-to-pinyin": "1.3.1",
    "cross-fetch": "4.1.0",
    "esbuild": "0.28.0",
    "eslint": "10.2.1",
    "eslint-config-prettier": "10.1.8",
    "eslint-import-resolver-alias": "1.1.2",
    "eslint-plugin-compat": "7.0.1",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-prettier": "5.5.5",
    "eslint-plugin-sort-class-members": "1.22.1",
    "iconv-lite": "0.7.2",
    "jszip": "3.10.1",
    "kuroshiro": "1.2.0",
    "kuroshiro-analyzer-kuromoji": "1.1.0",
    "lerna": "9.0.7",
    "natural": "8.1.1",
    "nodejieba": "3.5.8",
    "prettier": "3.8.3",
    "rollup": "4.60.2",
    "rollup-plugin-delete": "3.0.2",
    "sass-embedded": "1.99.0",
    "sprintf-js": "1.1.3",
    "tsx": "4.23.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.59.0",
    "vitest": "5.0.5",
    "vue-multiselect": "3.5.0",
    "vuepress": "2.0.0-rc.28",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zxcvbn": "4.4.2"
  },
  "keywords": [
    "password",
    "passphrase",
    "security",
    "authentication",
    "strength",
    "meter",
    "quality",
    "estimation",
    "pattern",
    "cracking",
    "scoring",
    "entropy",
    "bruteforce"
  ],
  "resolutions": {},
  "overrides": {},
  "dependencies": {}
}
